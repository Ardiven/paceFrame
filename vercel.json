{
    "services": {
        "frontend": {
            "root": "client/"
        },
        "backend": {
            "root": "server/",
            "framework": "express"
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": {
                "service": "server"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "service": "client"
            }
        }
    ]
}